# Auto-detect text files and normalize line endings
* text=auto

# Source and configuration files
*.md text
*.json text
*.yaml text
*.yml text
*.xml text
*.toml text
*.py text
*.js text
*.ts text
*.tsx text
*.css text
*.html text
*.bicep text

# Force LF for shell scripts and CI configs
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Generated and vendored files
*.min.js linguist-generated
*.min.css linguist-generated
package-lock.json linguist-generated
uv.lock linguist-generated
src/openapi.json linguist-generated
