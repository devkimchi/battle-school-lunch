# Required: get a key from https://open.neis.go.kr/
NEIS_API_KEY=replace-me

# Copilot SDK local authentication uses the signed-in user's Copilot account.
# A PAT is not needed locally. Choose a model if desired; the default is "auto".
COPILOT_AUTH_MODE=local
COPILOT_MODEL=auto

# Azure provisioning/deployment only: get values from "az account show"
Azure__SubscriptionId=<azure_subscription_id>
Azure__Location=<azure_location>

# Optional Azure provisioning/deployment settings
# Azure__TenantId=<azure_tenant_id>
# Azure__ResourceGroup=<azure_resource_group>

# Azure deployment only: add your own fine-grained PAT with Copilot Requests
# permission as the GitHub Actions repository secret COPILOT_GITHUB_TOKEN.
# Do not put that token in this file. Azure CLI login does not authenticate Copilot.

# Optional NEIS override
# NEIS_BASE_URL=https://open.neis.go.kr/hub
