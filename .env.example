# Required: get a key from https://open.neis.go.kr/
NEIS_API_KEY=replace-me

# Required for the multi-agent comparison service
FOUNDRY_PROJECT_ENDPOINT=https://replace-me.services.ai.azure.com/api/projects/replace-me
FOUNDRY_MODEL_DEPLOYMENT_NAME=replace-me

# Optional overrides
# NEIS_BASE_URL=https://open.neis.go.kr/hub
# MCP_PORT=8001
# WEB_PORT=8080

# Optional for Docker Compose outside Azure. Aspire local development uses az login.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
