# Required: get a key from https://open.neis.go.kr/
NEIS_API_KEY=replace-me

# Local Aspire run: get values from "az account show"
Azure__SubscriptionId=<azure_subscription_id>
Azure__Location=<azure_location>

# Optional Aspire run
Azure__TenantId=<azure_tenant_id>

# Optional NEIS override
# NEIS_BASE_URL=https://open.neis.go.kr/hub
